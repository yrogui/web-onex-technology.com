# ── Checklist CCaaS — Capture email (n8n) ──────────────────────────────────
# Webhook n8n — soumission du formulaire (POST: email, rgpd, source, timestamp, siteUrl, website)
NEXT_PUBLIC_N8N_CHECKLIST_WEBHOOK=https://flow.onextechnology.cloud/webhook/onex-newsletter-subscribe

# Webhook n8n — confirmation double opt-in (POST: token)
NEXT_PUBLIC_N8N_CHECKLIST_CONFIRM_WEBHOOK=https://flow.onextechnology.cloud/webhook/onex-newsletter-confirm

# URL publique du PDF checklist (hébergé dans /public ou CDN)
NEXT_PUBLIC_CHECKLIST_PDF_URL=https://onex-technology.com/assets/checklist-migration-ccaas-25-points.pdf

# ── Chat Widget IA ──────────────────────────────────────────────────────────
# Webhook n8n — chat assistant (POST: message, sessionId, history, pageUrl, userAgent)
NEXT_PUBLIC_N8N_CHAT_WEBHOOK=https://flow.onextechnology.cloud/webhook/onex-technology-chat

# Widget chat One-X — active seulement si true (OFF par defaut tant que backend n8n pas pret)
NEXT_PUBLIC_CHAT_ENABLED=false
