# Site Configuration
NEXT_PUBLIC_SITE_URL=https://onex-technology.com

# Contact Form (optionnel si vous souhaitez ajouter un backend pour les formulaires)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=contact@onex-technology.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=contact@onex-technology.com
# SMTP_TO=contact@onex-technology.com

# Google reCAPTCHA (optionnel pour protéger le formulaire de contact)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key

# Analytics (optionnel)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
